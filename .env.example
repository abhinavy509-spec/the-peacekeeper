# =========================================================
# Hostel Hisaab / The Peacekeeper - Environment Variables
# =========================================================

# Supabase API Credentials
# (Obtain from your Supabase Dashboard: Project Settings -> API)
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# AI Configuration (Bullshit-o-Meter & AI WhatsApp Notice Generator)
# 1. Google Gemini API (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. OpenAI API (Optional alternative)
# OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"

# (Note: If neither key is provided, the app automatically runs in 100% offline mode
# using the built-in funny Hinglish rule engine!)

# Optional: Cron jobs secret token
# CRON_SECRET="your-secure-cron-secret-token"
